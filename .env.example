# Database
# Dev (default): SQLite, zero-config, file lives at prisma/dev.db
DATABASE_URL="file:./dev.db"

# Prod: swap to PostgreSQL — also change provider in prisma/schema.prisma to "postgresql"
# DATABASE_URL="postgresql://user:password@host:5432/biech?schema=public"

# Required by GET /api/leads (admin endpoint). Use a long random string.
LEADS_API_KEY="change-me-to-a-long-random-string"
